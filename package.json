{
  "name": "skill-auditor",
  "version": "1.4.0",
  "description": "Audit imported Agent Skills (SKILL.md) against the reality of the project they are installed in.",
  "bin": {
    "skill-auditor": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "templates"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulgrape/skill-auditor.git"
  },
  "homepage": "https://github.com/paulgrape/skill-auditor#readme",
  "bugs": {
    "url": "https://github.com/paulgrape/skill-auditor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test"
  },
  "keywords": [
    "agent-skills",
    "agents",
    "ai-agent",
    "skills",
    "skill-md",
    "cursor",
    "claude",
    "codex",
    "alignment",
    "drift",
    "stack",
    "audit",
    "cli",
    "frontend",
    "react",
    "nextjs",
    "ast"
  ],
  "author": {
    "name": "Pavel Vinogradov",
    "email": "vin.pavel13@gmail.com",
    "url": "https://github.com/paulgrape"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
